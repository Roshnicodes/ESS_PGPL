<% content_for :title, "On Tour" %>
<% today = @date == Date.current %>
<%= page_header(today ? "On tour today" : "On tour", "#{d(@date)} · Tour Plans that are approved or waiting for approval. Click an employee for the tour details.", icon_name: :building) do %>
  <%= print_button %>
<% end %>

<div class="card overflow-hidden fade-up" data-controller="dialog">
  <div class="card-head">
    <%= form_with url: on_tour_path, method: :get, class: "flex w-full flex-wrap items-center gap-2" do %>
      <div class="relative w-full sm:w-72"><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= icon(:search, "h-4 w-4") %></span>
        <%= search_field_tag :q, params[:q], placeholder: "Name, code or designation…", class: "inp pl-9" %></div>
      <div class="w-44"><%= date_field_tag :date, @date, class: "inp", onchange: "this.form.requestSubmit()" %></div>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
      <%= button_tag class: "btn-light" do %><%= icon(:filter) %> Search<% end %>
      <span class="ml-auto flex flex-wrap gap-1.5 print:hidden">
        <% [["All", nil, :all], ["Approved", "approved", :approved], ["Waiting for approval", "pending", :pending]].each do |label, key, count_key| %>
          <%= link_to "#{label} (#{@counts[count_key]})", on_tour_path(q: params[:q].presence, date: (@date unless today), status: key),
                class: (params[:status].to_s == key.to_s ? "btn-primary btn-xs" : "btn-light btn-xs") %>
        <% end %>
      </span>
    <% end %>
  </div>

  <div class="overflow-x-auto"><table class="tbl tbl-hover tbl-stack">
    <thead><tr><th>Employee</th><th>Tour dates</th><th>Place on <%= d(@date) %></th><th>Tour status</th><th class="text-right no-print"></th></tr></thead>
    <tbody>
    <% @tours.each do |t| %>
      <% u = t.user; places = t.tour_visits.select { |v| v.visit_date == @date }.map(&:place).compact_blank.uniq %>
      <tr>
        <td data-label="Employee">
          <button type="button" class="flex items-center gap-3 text-left" data-action="dialog#open" data-dialog-id-param="on-tour-<%= t.id %>">
            <%= avatar(u, size: "h-9 w-9 text-xs") %>
            <span class="leading-tight"><b class="text-slate-900 hover:text-brand-700 hover:underline"><%= u.name %></b>
              <span class="block muted"><%= [u.designation, u.emp_code, u.location].compact_blank.join(" · ") %></span></span>
          </button>
        </td>
        <td data-label="Tour dates" class="whitespace-nowrap"><%= t.duration_label %> <span class="muted">(<%= t.days %> <%= t.days == 1 ? "day" : "days" %>)</span></td>
        <td data-label="Place"><%= places.any? ? places.join(", ") : tag.span("—", class: "muted") %></td>
        <td data-label="Tour status"><div><%= tour_status_badge(t) %><div class="muted mt-1"><%= t.stage_label %></div></div></td>
        <td class="text-right no-print"><button type="button" class="btn-light btn-xs" data-action="dialog#open" data-dialog-id-param="on-tour-<%= t.id %>"><%= icon(:eye) %> Details</button></td>
      </tr>
    <% end %>
    <% if @tours.empty? %><tr><td colspan="5" class="td-empty py-10 text-center text-sm text-slate-500">No one is on tour on <%= d(@date) %>.</td></tr><% end %>
    </tbody>
  </table></div>

  <%# one details popup per tour %>
  <% @tours.each do |t| %>
    <% u = t.user %>
    <dialog id="on-tour-<%= t.id %>" data-action="click->dialog#backdrop"
            class="m-auto w-[min(46rem,calc(100vw-1.5rem))] rounded-2xl border border-white/70 bg-white p-0 shadow-2xl backdrop:bg-slate-900/40">
      <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div class="flex items-center gap-3">
          <%= avatar(u, size: "h-10 w-10 text-sm") %>
          <div class="leading-tight"><div class="font-semibold text-slate-900"><%= u.name %></div>
            <div class="muted"><%= [u.designation, u.emp_code, u.department, u.location].compact_blank.join(" · ") %></div></div>
        </div>
        <button type="button" class="btn-ghost btn-xs" data-action="dialog#close" aria-label="Close"><%= icon(:x_circle, "h-5 w-5") %></button>
      </div>
      <div class="max-h-[70vh] space-y-4 overflow-y-auto px-5 py-4 text-sm">
        <div class="grid gap-3 sm:grid-cols-3">
          <div><div class="lbl">Tour dates</div><b><%= t.duration_label %></b></div>
          <div><div class="lbl">Total days</div><b><%= t.days %> <%= t.days == 1 ? "day" : "days" %></b></div>
          <div><div class="lbl">Tour status</div><%= tour_status_badge(t) %><div class="muted mt-1"><%= t.stage_label %></div></div>
        </div>
        <div><div class="lbl">Approval</div><div class="flex flex-wrap items-center"><%= approver_chain(t.approver, t.l2_approver, t.approval_steps) %></div></div>
        <% if t.general_description.present? %><div><div class="lbl">Purpose / description</div><div class="text-slate-700"><%= t.general_description %></div></div><% end %>
        <div>
          <div class="lbl">Visit plan</div>
          <table class="tbl text-xs">
            <thead><tr><th>Date</th><th>Place</th><th>Mode of travel</th><th>Planned activity</th></tr></thead>
            <tbody>
              <% t.tour_visits.sort_by(&:visit_date).each do |v| %>
                <tr class="<%= 'bg-amber-50 font-semibold' if v.visit_date == @date %>">
                  <td class="whitespace-nowrap"><%= d(v.visit_date) %><%= " (today)" if v.visit_date == Date.current %></td>
                  <td><%= v.place %></td><td><%= v.travel_mode || "—" %></td><td><%= v.planned_activity %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
